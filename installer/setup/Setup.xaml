<!--
  afterterm Setup: the four screens of the installer, as agreed against the
  "afterterm Setup" mockup on 2026-10-29. Loaded at runtime by Setup.cs
  (XamlReader), which finds the named elements and wires them up.
  Colours are afterterm's: #212121 window, #ECECEC text, #9A9A9A secondary text,
  #1A1A1A fields, teal #20B2AA for progress and ticks.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="afterterm Setup" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#212121" Foreground="#ECECEC"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Text2" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Line" Color="#2F2F2F"/>

    <!-- The logo: the same geometry as assets/icon.ico (scripts/generate-icons.js). -->
    <DrawingImage x:Key="Logo">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#1A1A1A">
            <GeometryDrawing.Pen><Pen Brush="#363636" Thickness="3"/></GeometryDrawing.Pen>
            <GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,240,240" RadiusX="40" RadiusY="40"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#20B2AA"><GeometryDrawing.Geometry><EllipseGeometry Center="88,55" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#D28C32"><GeometryDrawing.Geometry><EllipseGeometry Center="128,55" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#9467BD"><GeometryDrawing.Geometry><EllipseGeometry Center="168,55" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Geometry="M70,120 L160,165 L70,210">
            <GeometryDrawing.Pen><Pen Brush="#E0E0E0" Thickness="14" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#E0E0E0"><GeometryDrawing.Geometry><RectangleGeometry Rect="175,145,12,45" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Tick">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#20B2AA"><GeometryDrawing.Geometry><EllipseGeometry Center="10,10" RadiusX="9" RadiusY="9"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Geometry="M6,10.4 L8.6,13 L14,7.6">
            <GeometryDrawing.Pen><Pen Brush="#0D0D0D" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Cross">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#F2786D"><GeometryDrawing.Geometry><EllipseGeometry Center="10,10" RadiusX="9" RadiusY="9"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Geometry="M7,7 L13,13 M13,7 L7,13">
            <GeometryDrawing.Pen><Pen Brush="#0D0D0D" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Buttons: secondary (dark) and primary (light), 6 px corners. -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#ECECEC"/>
      <Setter Property="Background" Value="#2F2F2F"/>
      <Setter Property="BorderBrush" Value="#3A3A3A"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#383838"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#20B2AA"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#0D0D0D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#ECECEC" BorderBrush="#ECECEC" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#20B2AA"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#9A9A9A"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="c"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#ECECEC"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECECEC"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="4" BorderBrush="#5A5A5A" BorderThickness="1" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="mark" Data="M2.5,7.3 L5.7,10.4 L11.8,3.8" Stroke="#0D0D0D" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#ECECEC"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#ECECEC"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#20B2AA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A thin dark scrollbar (the report box only scrolls vertically). -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#4A4A4A" CornerRadius="3" Margin="3,2"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Footer" TargetType="Border">
      <Setter Property="BorderBrush" Value="#2F2F2F"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="20,16"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Width="600" Height="440">

    <!-- 1. Welcome -->
    <Grid x:Name="PageWelcome">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
        <Image Source="{StaticResource Logo}" Width="80" Height="80"/>
        <TextBlock x:Name="WelcomeName" Text="afterterm" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        <TextBlock x:Name="WelcomeVersion" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <TextBlock Text="Install to" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,26,0,6"/>
        <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="10,3,3,3">
          <DockPanel>
            <Button x:Name="ChangeBtn" DockPanel.Dock="Right" Content="Change" Style="{StaticResource Btn}" Height="28" MinWidth="0" Padding="14,0" FontSize="12.5"/>
            <TextBlock x:Name="FolderText" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,10,0"/>
          </DockPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <CheckBox x:Name="DesktopCb" Content="Desktop shortcut" IsChecked="True"/>
          <CheckBox x:Name="StartCb" Content="Start menu shortcut" IsChecked="True" Margin="24,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="WelcomeMsg" Foreground="#FBBF24" FontSize="12.5" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Footer}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="WelcomeCancel" Content="Cancel" Style="{StaticResource Btn}"/>
          <Button x:Name="InstallBtn" Content="Install" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 2. Installing -->
    <Grid x:Name="PageInstall" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
        <Image Source="{StaticResource Logo}" Width="56" Height="56"/>
        <TextBlock x:Name="InstallTitle" Text="Installing afterterm" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        <Border Width="340" Height="4" CornerRadius="2" Background="#333333" Margin="0,22,0,0">
          <Border x:Name="Bar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="#20B2AA"/>
        </Border>
        <TextBlock x:Name="Pct" Text="0%" FontSize="12" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock x:Name="InstallError" Foreground="#F2786D" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Footer}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="InstallCancel" Content="Cancel" Style="{StaticResource Btn}" IsEnabled="False"/>
          <Button x:Name="InstallClose" Content="Close" Style="{StaticResource Primary}" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 3. Checking Claude Code -->
    <Grid x:Name="PageCheck" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
        <TextBlock x:Name="CheckTitle" Text="Checking Claude Code" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,26"/>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <ContentControl x:Name="Ic1" Width="20" Height="20" VerticalAlignment="Top"/>
          <TextBlock x:Name="T1" Grid.Column="1" Text="Claude Code found" FontSize="14" Margin="12,0,0,0" Foreground="{StaticResource Text2}"/>
        </Grid>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ContentControl x:Name="Ic2" Width="20" Height="20" VerticalAlignment="Top"/>
          <TextBlock x:Name="T2" Grid.Column="1" Text="Notifications work" FontSize="14" Margin="12,0,0,0" Foreground="{StaticResource Text2}"/>
          <TextBlock x:Name="Note" Grid.Row="1" Grid.Column="1" FontSize="12.5" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="12,6,0,0" Visibility="Collapsed"
                     Text="Windows blocked afterterm's helper on this PC. afterterm works, without these two."/>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <ContentControl x:Name="Ic3" Width="20" Height="20" VerticalAlignment="Top"/>
          <TextBlock x:Name="T3" Grid.Column="1" Text="Chats come back after Sleep" FontSize="14" Margin="12,0,0,0" Foreground="{StaticResource Text2}"/>
        </Grid>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Footer}">
        <DockPanel>
          <Button x:Name="ReportBtn" Content="Report issue" Style="{StaticResource Btn}" Visibility="Collapsed"/>
          <Button x:Name="CheckNext" Content="Next" Style="{StaticResource Primary}" HorizontalAlignment="Right" IsEnabled="False"/>
        </DockPanel>
      </Border>

      <!-- Report issue: a sheet over the page -->
      <Grid x:Name="Sheet" Grid.RowSpan="2" Background="#212121" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="SheetForm" Margin="40,30,40,0">
          <TextBlock Text="Report this issue" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Opens GitHub with this report filled in. Never your files or chats." Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <Button x:Name="SeeBtn" Content="See what's sent" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          <TextBox x:Name="ReportBox" IsReadOnly="True" Visibility="Collapsed" Margin="0,10,0,0" MaxHeight="190"
                   Background="#1A1A1A" Foreground="#9A9A9A" BorderBrush="#3A3A3A" Padding="10,8"
                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel x:Name="SheetSent" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <Image Source="{StaticResource Tick}" Width="40" Height="40"/>
          <TextBlock Text="Opened in your browser" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock Text="Click Submit new issue on GitHub to send it." Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Footer}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SheetCancel" Content="Cancel" Style="{StaticResource Btn}"/>
            <Button x:Name="SheetOpen" Content="Open GitHub" Style="{StaticResource Primary}" Margin="8,0,0,0"/>
            <Button x:Name="SheetDone" Content="Done" Style="{StaticResource Primary}" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- 4. Ready -->
    <Grid x:Name="PageReady" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="{StaticResource Logo}" Width="96" Height="96"/>
        <TextBlock x:Name="ReadyTitle" Text="afterterm is ready" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        <CheckBox x:Name="OpenCb" Content="Open afterterm" IsChecked="True" HorizontalAlignment="Center" Margin="0,20,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Footer}">
        <Button x:Name="FinishBtn" Content="Finish" Style="{StaticResource Primary}" HorizontalAlignment="Right" IsDefault="True"/>
      </Border>
    </Grid>

    <!-- 5. Updating: the quiet update mode (afterterm's Restart to update runs
         Setup in update mode, see Setup.cs). Only this page shows, in a smaller window: the
         logo, "Updating afterterm to 0.11.0", a bar, a percentage. The footer
         appears only when the update could not be installed. -->
    <Grid x:Name="PageUpdate" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="40,36,40,44" HorizontalAlignment="Center" Width="390">
        <Image Source="{StaticResource Logo}" Width="64" Height="64"/>
        <TextBlock x:Name="UpdateTitle" Text="Updating afterterm" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        <Border Width="390" Height="5" CornerRadius="2.5" Background="#333333" Margin="0,18,0,0">
          <Border x:Name="UpdateBar" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="#20B2AA"/>
        </Border>
        <TextBlock x:Name="UpdatePct" Text="0%" FontSize="13" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock x:Name="UpdateError" Foreground="#F2786D" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>
      <Border x:Name="UpdateFooter" Grid.Row="1" Style="{StaticResource Footer}" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UpdateClose" Content="Close" Style="{StaticResource Btn}"/>
          <Button x:Name="UpdateOpen" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
