{
  "name": "afterterm",
  "productName": "afterterm",
  "version": "0.8.1",
  "description": "Terminal emulator with Chrome-style tab groups",
  "main": ".vite/build/main.js",
  "license": "MIT",
  "author": "Aryan Saxena",
  "homepage": "https://github.com/afteraryan/afterterm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/afteraryan/afterterm.git"
  },
  "bugs": {
    "url": "https://github.com/afteraryan/afterterm/issues"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "build": "node scripts/build.js",
    "release": "node scripts/release.js",
    "make-shareable": "pwsh -File scripts/make-shareable.ps1",
    "make": "electron-forge make",
    "postinstall": "electron-rebuild",
    "harness": "node scripts/agent-harness/launch.mjs",
    "harness:drive": "node scripts/agent-harness/drive.mjs",
    "harness:stop": "node scripts/agent-harness/stop.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron/rebuild": "^3.7.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.4.5",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
